# =============================================================================
# Timbangan Digital — Environment PRODUKSI (Docker / VPS)
#
# Cara pakai di VPS:
#   cp .env.production.example .env
#   nano .env           # isi APP_URL, password DB, secret Reverb, domain WS
#   docker compose run --rm app php artisan key:generate   # isi APP_KEY
#
# PENTING: nilai VITE_* di-bake saat build image. Jika diubah, WAJIB
#          `docker compose build` ulang agar bundle JS ikut berubah.
# =============================================================================

APP_NAME=Timbangan-Digital
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://timbangan.example.com
APP_TIMEZONE=Asia/Jakarta

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=error

# --- Database (host = nama service docker "mysql") ---------------------------
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=timbangan
DB_USERNAME=timbangan
DB_PASSWORD=ganti_password_db_ini
# Password root MySQL (dipakai container mysql & healthcheck; bukan oleh Laravel)
DB_ROOT_PASSWORD=ganti_password_root_ini

# Seeding otomatis saat container "app" start (entrypoint):
#   auto   (default) -> seed HANYA saat database masih kosong / fresh install.
#                       Aman: restart & redeploy tidak menghapus data.
#   always           -> paksa seed tiap start. PERINGATAN: DatabaseSeeder
#                       melakukan truncate, jadi ini MENGHAPUS & mengisi ulang
#                       data. Pakai hanya bila memang ingin reset.
#   never            -> jangan pernah seed otomatis (seed manual bila perlu).
DB_SEED=auto

# --- Session / Cache / Queue -------------------------------------------------
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

# --- Broadcasting (Reverb) ---------------------------------------------------
BROADCAST_CONNECTION=reverb

# Kredensial aplikasi Reverb — GANTI ketiganya dengan nilai acak yang kuat.
REVERB_APP_ID=123456
REVERB_APP_KEY=ganti_reverb_key
REVERB_APP_SECRET=ganti_reverb_secret

# Bind proses Reverb DI DALAM container (jangan diubah untuk setup docker ini).
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080

# Koneksi server-side (app -> reverb) lewat jaringan docker internal.
# "reverb" = nama service di docker-compose. Jangan diganti ke domain publik.
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http

# --- Koneksi WebSocket dari BROWSER (di-bake ke bundle JS saat build) --------
# Skenario A — pakai domain + HTTPS (direkomendasikan, lewat Nginx :443):
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST=timbangan.example.com
VITE_REVERB_PORT=443
VITE_REVERB_SCHEME=https
#
# Skenario B — hanya IP publik tanpa SSL (lewat Nginx :80), ganti jadi:
#   VITE_REVERB_HOST=IP_VPS_ANDA
#   VITE_REVERB_PORT=80
#   VITE_REVERB_SCHEME=http

VITE_APP_NAME="${APP_NAME}"

# --- Mail (opsional, isi bila perlu kirim email) -----------------------------
# MAIL_MAILER=smtp
# MAIL_HOST=smtp-relay.brevo.com
# MAIL_PORT=587
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_FROM_ADDRESS="no-reply@example.com"
# MAIL_FROM_NAME="${APP_NAME}"
