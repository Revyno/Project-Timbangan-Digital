                        ],
                        "url": {
                            "raw": "{{base_url}}/api/v1/status",
                            "host": ["{{base_url}}"],
                            "path": ["api", "v1", "status"]
                        },
                        "description": "Health check server + versi API. Tanpa auth."
                    }
                },
                {
                    "name": "GET /api/status (legacy)",
