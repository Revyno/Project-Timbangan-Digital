        "_postman_id": "timbangan-digital-v1"
    },
    "variable": [
        {
            "key": "base_url",
            "value": "http://localhost:8000",
            "description": "URL server Laravel local (ganti port jika beda)"
        },
        {
            "key": "token_fg_pasuruan",
            "value": "FG-PASURUAN-001",
            "description": "Device token FG Pasuruan (dari seeder)"
        },
        {
            "key": "token_fg_psn",
            "value": "FG-PSN-001",
            "description": "Device token FG PSN"
        },
        {
            "key": "token_fg_sby",
            "value": "FG-SBY-001",
            "description": "Device token FG Surabaya"
        },
        {
            "key": "token_formulasi",
            "value": "FORM-PASURUAN-001",
            "description": "Device token Formulasi Pasuruan"
        },
        {
            "key": "token_singkong",
            "value": "INC-SINGKONG-001",
            "description": "Device token Incoming Singkong"
        },
        {
            "key": "token_rmpm",
            "value": "INC-RMPM-001",
            "description": "Device token Incoming RMPM"
        },
        {
            "key": "token_cs_noodle",
            "value": "CS-NOODLE-SBY-001",
            "description": "Device token CS Noodle Sby (sesuaikan bila ada di seeder)"
