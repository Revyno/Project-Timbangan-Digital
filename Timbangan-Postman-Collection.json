            "key": "token_cs_fg",
            "value": "CS-FG-SBY-001",
            "description": "Device token CS FG Sby"
        },
        {
            "key": "sync_token",
            "value": "your-sync-token-here",
            "description": "Nilai dari ONLINE_SYNC_TOKEN di .env (untuk endpoint sync)"
        },
        {
            "key": "qr_code_driver",
            "value": "DRV-xxxxxxxx",
            "description": "QR code driver dari registrasi (cek DB drivers.qr_code)"
        }
    ],
